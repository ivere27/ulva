(global_label "3V3" (shape input) (at 167.64 91.44 180) (effects (font (size 1.27 1.27)) (justify right)) (uuid "320bece8-87ff-5548-90ae-b68869b03cc8"))
(text "24V input monitor / GPIO5 ADC1_CH4 / J7.9" (at 12 18 0) (effects (font (size 2 2)) (justify left)) (uuid "a5c8ce9e-679e-50ca-ac22-ea859419d9bb"))
(text "VIN_24V is sensed against logic GND. Existing regulator and ZONE_ENABLE are independent." (at 12 27 0) (effects (font (size 1.27 1.27)) (justify left)) (uuid "6290156d-4295-5109-b638-7099484f1380"))
(text "Nominal: 24V -> 1.500V, 36V -> 2.250V; multiply calibrated ADC voltage by16." (at 12 127 0) (effects (font (size 1.27 1.27)) (justify left)) (uuid "b583696c-247c-56e8-b551-43a3de026a1a"))
(text "Rth=150k||10k+1k=10.375k; C16=100nF; tau=1.0375ms, fc=153.4Hz." (at 12 133.35 0) (effects (font (size 1.27 1.27)) (justify left)) (uuid "2b5d8eaf-b394-50b2-aa44-25049adf21c9"))
(text "D7: pin1 GND -> diode -> pin3 ADC -> diode -> pin2 3V3 (manufacturer verified)." (at 12 139.7 0) (effects (font (size 1.27 1.27)) (justify left)) (uuid "708e7e58-fc2a-589d-82c8-72d1255f03a9"))
(text "Rail clamp is not power-off isolation. If24V remains while3V3 is off, upper diode can backfeed3V3." (at 12 146.05 0) (effects (font (size 1.27 1.27)) (justify left)) (uuid "b39da4f2-7ac5-572c-a3cc-78df00f198fd"))
(text "Calibration, leakage/temperature, actual ADC noise and startup/shutdown tests remain pending." (at 12 152.4 0) (effects (font (size 1.27 1.27)) (justify left)) (uuid "0ede1337-2f24-52b6-b19d-9ba5c82099d4"))
(text "GPIO5 must remain an ADC input; no output drive or internal pulls. Shared ADC1 handle with buttons/DIP." (at 12 158.75 0) (effects (font (size 1.27 1.27)) (justify left)) (uuid "57d51a9a-3f69-5ded-b7ff-5bedf38364c0"))
(text "Four Basic passives + HJC C7420333 Preferred Extended. Monitor does not increase board input rating." (at 12 165.1 0) (effects (font (size 1.27 1.27)) (justify left)) (uuid "393fcd95-d118-59f7-b0f0-d0caefa40d7a"))
(embedded_fonts no)
