 (title_block (title "Ulva / External interface notes") (date "2026-10-13") (rev "v0.42") (company "Ulva"))
 (lib_symbols)
 (text "External interface notes" (at 12 18 0) (effects (font (size 2.3 2.3)) (justify left)) (uuid "c386b8ec-f481-5087-a764-9f0e6660de69"))
 (text "External modules are separate hardware; they are not included in the carrier BOM or PCB." (at 12 29 0) (effects (font (size 1.27 1.27)) (justify left)) (uuid "42aeca99-2673-52a4-bb66-891ef37f8090"))
 (text "AC0/J8 and AC1/J9 share one isolated 24VAC source and one K1 return switch." (at 12 43 0) (effects (font (size 1.27 1.27)) (justify left)) (uuid "43589174-daca-5a19-bada-068163b2d9db"))
 (text "J12-J17 are parallel AC inputs. Select one input and fit the required external inline fuse." (at 12 51 0) (effects (font (size 1.27 1.27)) (justify left)) (uuid "caec5894-7980-54ce-a506-7ff3cf0f4a83"))
 (text "EACRET is distinct from logic GND. See docs/hardware.md for the complete IDC pin map." (at 12 59 0) (effects (font (size 1.27 1.27)) (justify left)) (uuid "9b2854fd-9c5f-572b-9895-916e5d0cbaa0"))
 (text "DC0/J10 and DC1/J11 share DC_ZONE_RETURN. Q2 switches this return to DC_DRIVER_COM." (at 12 74 0) (effects (font (size 1.27 1.27)) (justify left)) (uuid "edb15376-8678-5a9d-9db2-33cf05c90e50"))
 (text "J18-J23 driver COM terminals and J25 POWER_0V are separate on this PCB." (at 12 82 0) (effects (font (size 1.27 1.27)) (justify left)) (uuid "6eb98a5d-8737-5cd2-993e-b85b22d312de"))
 (text "The U1/Q2 gate drive requires driver COM and POWER_0V to share the external PSU negative." (at 12 90 0) (effects (font (size 1.27 1.27)) (justify left)) (uuid "fd9d626f-e2b9-54ac-b5ca-242c964984ef"))
 (text "External expanders can provide a return path around an open Q2; actual driver release needs testing." (at 12 98 0) (effects (font (size 1.27 1.27)) (justify left)) (uuid "6dbe439d-bcff-55fc-a3d2-c31d8c4411f6"))
 (text "Read docs/hardware.md before using the common-return switch to stop a driver." (at 12 106 0) (effects (font (size 1.27 1.27)) (justify left)) (uuid "f69ba970-7776-536f-ad89-f0f201f9f533"))
 (text "Upstream OpenSprinkler Expander schematics and their license:" (at 12 126 0) (effects (font (size 1.27 1.27)) (justify left)) (uuid "6e8931a4-be00-5e1f-a8c1-b1cb98d2f14a"))
 (text "https://github.com/OpenSprinkler/OpenSprinkler-Hardware/tree/master/Expander/3.0" (at 12 134 0) (effects (font (size 1.05 1.05)) (justify left)) (uuid "ed2250b3-8228-59bd-95cc-bd2c1598c8ed"))
 (text "https://github.com/OpenSprinkler/OpenSprinkler-Hardware/blob/master/LICENSE.txt" (at 12 142 0) (effects (font (size 1.05 1.05)) (justify left)) (uuid "d8fb892b-2559-5e66-a5cd-ae11e9dfe8f4"))
 (text "See docs/hardware.md for pin assignments, connections and operating limits." (at 12 161 0) (effects (font (size 1.27 1.27)) (justify left)) (uuid "43b8a2af-ada2-5df2-96f4-f46ea7f43621"))
